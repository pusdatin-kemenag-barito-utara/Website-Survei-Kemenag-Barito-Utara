# ==============================================================================
# SI-ARUS Kemenag Barito Utara - Environment Variables Template
# ==============================================================================
# All secrets and environment variables are centrally managed in Infisical Cloud:
# Project: "Kemenag Barito Utara" (ad5be957-3c8a-4c2e-b21e-3838cc3a7c0e)
# Path: /survei-kemenag
#
# For local development, running `npm run dev` automatically authenticates
# and injects all secrets from Infisical into your processes.
#
# If you need to generate a local .env file from Infisical, run:
#   npm run env:pull       (for dev)
#   npm run env:pull:prod  (for prod)
# ==============================================================================

# Server & Runtime
NODE_ENV=development
TZ=Asia/Jakarta
HOSTNAME=0.0.0.0
PORT=8080
GO_PORT=8080
BACKEND_PORT=8080

# Application URLs
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080/api/v1
PUBLIC_PUSDATIN_URL=https://pusdatin.kemenag-baritoutara.com
PUBLIC_PUSDATIN_SCHEMA=kemenag_survey

# API Proxy
ENABLE_API_PROXY=true
API_PROXY_TARGET=http://127.0.0.1:8080

# Security & CORS
JWT_SECRET=your-jwt-secret
CORS_ORIGINS=https://survei.kemenag-baritoutara.com,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=https://survei.kemenag-baritoutara.com,http://localhost:3000,http://127.0.0.1:3000

# Supabase & Database
DATABASE_URL=postgresql://user:pass@host:port/postgres
DIRECT_URL=postgresql://user:pass@host:port/postgres
PUBLIC_SUPABASE_URL=https://your-supabase-url.com
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Credentials
SUPER_ADMIN_EMAIL=admin@kemenag.go.id
PUBLIC_SUPER_ADMIN_EMAIL=admin@kemenag.go.id
SUPER_ADMIN_PASSWORD=your-super-admin-password

# Cloudflare & Analytics
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
PUBLIC_CF_BEACON_TOKEN=your-cloudflare-beacon-token
PUBLIC_CLOUDFLARE_RUM_ENABLED=true
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GTAG_ID=GT-XXXXXXXXXX
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Directives
ASTRO_TELEMETRY_DISABLED=1
NIXPACKS_NODE_VERSION=22
NIXPACKS_PKGS=go nodejs
