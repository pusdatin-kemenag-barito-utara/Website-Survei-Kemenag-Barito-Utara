coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Misc
.vscode/
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Typescript & Next.js Cache
*.tsbuildinfo
next-env.d.ts

